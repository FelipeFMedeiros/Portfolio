{
  "name": "portfolio",
  "author": "felipefmedeiros",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run assets && bun --bun vite",
    "host": "bun run assets && bun --bun vite --host",
    "typecheck": "bun run assets && bun --bun tsc -b",
    "build": "bun run typecheck && bun scripts/build.mjs",
    "lint": "bun --bun eslint .",
    "preview": "bun --bun vite preview",
    "audit": "node scripts/audit.mjs",
    "assets": "bun scripts/images.mjs",
    "analyze": "bun run typecheck && bun scripts/build.mjs --analyze",
    "test:build": "node scripts/verify-build.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "lighthouse": "^13.5.0",
    "puppeteer-core": "^25.15.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
